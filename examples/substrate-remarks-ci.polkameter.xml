<?xml version="1.0" encoding="UTF-8"?>
<!--
  A short System.remark test for CI, with the substrate plugin, at a low rate for this dev chain.
  Run polkameter run with an output directory and fail-on set to verdict. The job fails on a FAIL verdict,
  for example when too few transactions are included or they take too long.
  Made for the dev chain of scripts/dev-chain.sh (6-second blocks, //Alice funded).
  The seed credential is a secret URI, such as //Alice on a dev chain:
    polkameter plugin credential substrate-dev POLKAMETER_SUBSTRATE_SEED
    export POLKAMETER_SUBSTRATE_SEED=//Alice
-->
<polkameter-plan xmlns="https://polkameter.dev/schema/plan" version="1" name="Substrate remarks CI" mode="stress" timeout-ms="900000">
  <plugins><plugin id="substrate" version="0.4.8" protocol="1"/></plugins>
  <targets><target id="chain" endpoint="ws://127.0.0.1:9944"/></targets>
  <credentials><credential id="seed" profile="substrate-dev"/></credentials>
  <preflight>
    <step id="chain" use="substrate.preflight">
      <input name="target" ref="targets.chain"/>
      <input name="calls" value="[&quot;System.remark&quot;]"/>
    </step>
  </preflight>
  <setup>
    <step id="fund" use="substrate.fund-accounts" timeout-ms="300000">
      <input name="target" ref="targets.chain"/>
      <input name="seed" ref="credentials.seed"/>
      <input name="flood-signers" value="4"/>
      <input name="probes" ref="run.probeBudget"/>
      <input name="amount" value="100000000000000"/>
    </step>
    <step id="prepare" use="substrate.prepare-remarks" timeout-ms="120000">
      <input name="target" ref="targets.chain"/>
      <input name="seed" ref="credentials.seed"/>
      <input name="flood-signers" value="4"/>
      <input name="count" value="200"/>
      <input name="probes" ref="run.probeBudget"/>
    </step>
  </setup>
  <load target="chain" source-ref="steps.prepare.flood" probes-ref="steps.prepare.probes"
        state-check="substrate.check-state" state-ref="steps.prepare.state"
        baseline-probes="2" recovery-seconds="60" block-interval-seconds="6">
    <rate tx-per-second="5" seconds="30"/>
  </load>
  <thresholds min-included-ratio="0.99"/>
</polkameter-plan>
