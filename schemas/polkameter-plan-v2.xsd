<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:p="https://polkameter.dev/schema/plan/v2" targetNamespace="https://polkameter.dev/schema/plan/v2" elementFormDefault="qualified">
  <!-- Semantic validation (references, plugin contracts, budgets) is performed by the host. -->
<xs:complexType name="input"><xs:attribute name="name" type="xs:string" use="required"/><xs:attribute name="ref" type="xs:string"/><xs:attribute name="value" type="xs:string"/></xs:complexType>
<xs:complexType name="step"><xs:sequence><xs:element name="input" type="p:input" minOccurs="0" maxOccurs="unbounded"/></xs:sequence><xs:attribute name="id" type="xs:string" use="required"/><xs:attribute name="use" type="xs:string" use="required"/><xs:attribute name="timeout-ms" type="xs:positiveInteger"/></xs:complexType>
<xs:complexType name="steps"><xs:sequence><xs:element name="step" type="p:step" minOccurs="0" maxOccurs="unbounded"/></xs:sequence></xs:complexType>
<xs:complexType name="plugin"><xs:attribute name="id" type="xs:string" use="required"/><xs:attribute name="version" type="xs:string" use="required"/><xs:attribute name="protocol" type="xs:positiveInteger" use="required"/></xs:complexType>
<xs:complexType name="plugins"><xs:sequence><xs:element name="plugin" type="p:plugin" minOccurs="0" maxOccurs="unbounded"/></xs:sequence></xs:complexType>
<xs:complexType name="target"><xs:attribute name="id" type="xs:string" use="required"/><xs:attribute name="endpoint" type="xs:anyURI" use="required"/></xs:complexType>
<xs:complexType name="targets"><xs:sequence><xs:element name="target" type="p:target" minOccurs="0" maxOccurs="unbounded"/></xs:sequence></xs:complexType>
<xs:complexType name="credential"><xs:attribute name="id" type="xs:string" use="required"/><xs:attribute name="profile" type="xs:string" use="required"/></xs:complexType>
<xs:complexType name="credentials"><xs:sequence><xs:element name="credential" type="p:credential" minOccurs="0" maxOccurs="unbounded"/></xs:sequence></xs:complexType>
<xs:complexType name="workflow"><xs:sequence><xs:element name="step" type="p:step" minOccurs="0" maxOccurs="unbounded"/></xs:sequence><xs:attribute name="id" type="xs:string" use="required"/><xs:attribute name="users" type="xs:positiveInteger"/><xs:attribute name="iterations" type="xs:positiveInteger"/><xs:attribute name="concurrency" type="xs:positiveInteger"/></xs:complexType>
<xs:complexType name="rate"><xs:attribute name="tx-per-second" type="xs:double" use="required"/><xs:attribute name="seconds" type="xs:positiveInteger" use="required"/></xs:complexType>
<xs:complexType name="ramp"><xs:attribute name="start" type="xs:double" use="required"/><xs:attribute name="step" type="xs:double"/><xs:attribute name="growth" type="xs:double"/><xs:attribute name="steps" type="xs:positiveInteger" use="required"/><xs:attribute name="seconds" type="xs:positiveInteger" use="required"/></xs:complexType>
<xs:complexType name="load"><xs:choice><xs:element name="rate" type="p:rate" minOccurs="1" maxOccurs="unbounded"/><xs:element name="ramp" type="p:ramp" minOccurs="1" maxOccurs="1"/></xs:choice><xs:attribute name="target" type="xs:string" use="required"/><xs:attribute name="source-ref" type="xs:string" use="required"/><xs:attribute name="probes-ref" type="xs:string" use="required"/><xs:attribute name="state-check" type="xs:string"/><xs:attribute name="state-ref" type="xs:string"/><xs:attribute name="connections" type="xs:positiveInteger"/><xs:attribute name="baseline-probes" type="xs:positiveInteger"/><xs:attribute name="recovery-seconds" type="xs:nonNegativeInteger"/><xs:attribute name="block-interval-seconds" type="xs:double"/></xs:complexType>
<xs:complexType name="metric"><xs:attribute name="role" type="xs:string" use="required"/><xs:attribute name="name" type="xs:string" use="required"/></xs:complexType>
<xs:complexType name="monitors"><xs:sequence><xs:element name="metric" type="p:metric" minOccurs="0" maxOccurs="unbounded"/></xs:sequence><xs:attribute name="topology" type="xs:string" use="required"/><xs:attribute name="relay-target" type="xs:string" use="required"/><xs:attribute name="para-id" type="xs:positiveInteger" use="required"/></xs:complexType>
<xs:complexType name="thresholds"><xs:attribute name="stall-ms" type="xs:positiveInteger"/><xs:attribute name="finality-stall-ms" type="xs:positiveInteger"/><xs:attribute name="max-p95-latency-ms" type="xs:positiveInteger"/><xs:attribute name="max-submit-reply-ms" type="xs:positiveInteger"/><xs:attribute name="min-included-ratio" type="xs:double"/><xs:attribute name="max-refused-ratio" type="xs:double"/><xs:attribute name="pool-refuses-ratio" type="xs:double"/><xs:attribute name="min-send-ratio" type="xs:double"/><xs:attribute name="max-block-gap-factor" type="xs:double"/><xs:attribute name="probes-in-a-row" type="xs:positiveInteger"/><xs:attribute name="recovered-block-gap-factor" type="xs:double"/><xs:attribute name="finality-wait-ms" type="xs:positiveInteger"/></xs:complexType>
<xs:element name="polkameter-plan"><xs:complexType><xs:sequence><xs:element name="plugins" type="p:plugins" minOccurs="0" maxOccurs="1"/><xs:element name="targets" type="p:targets" minOccurs="0" maxOccurs="1"/><xs:element name="credentials" type="p:credentials" minOccurs="0" maxOccurs="1"/><xs:element name="preflight" type="p:steps" minOccurs="0" maxOccurs="1"/><xs:element name="setup" type="p:steps" minOccurs="0" maxOccurs="1"/><xs:element name="workflow" type="p:workflow" minOccurs="0" maxOccurs="unbounded"/><xs:element name="load" type="p:load" minOccurs="0" maxOccurs="1"/><xs:element name="monitors" type="p:monitors" minOccurs="0" maxOccurs="1"/><xs:element name="thresholds" type="p:thresholds" minOccurs="0" maxOccurs="1"/><xs:element name="evaluate" type="p:steps" minOccurs="0" maxOccurs="1"/><xs:element name="teardown" type="p:steps" minOccurs="0" maxOccurs="1"/></xs:sequence><xs:attribute name="name" type="xs:string" use="required"/><xs:attribute name="version" type="xs:positiveInteger" use="required"/><xs:attribute name="mode" type="xs:string"/><xs:attribute name="timeout-ms" type="xs:positiveInteger"/></xs:complexType></xs:element>
</xs:schema>
