<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:p="https://polkameter.dev/schema/plan"
           targetNamespace="https://polkameter.dev/schema/plan" elementFormDefault="qualified">
  <xs:annotation>
    <xs:documentation>
      XSD 1.0 checks local structure and value limits. Always run polkameter validate too.
      The CLI checks section cardinality (all root children except workflow occur at most once),
      scoped and ordered output references, declared operation providers, monitors requiring load,
      and expanded ramp rates remaining finite and nonnegative. The choice at the root allows
      sections in any order, including repeated workflows; xs:all cannot repeat workflows in XSD 1.0.
      The CLI also applies parser limits (2 MiB, depth 16, no DOCTYPE/CDATA or non-leading processing instructions).
      XSD cannot reproduce these parser restrictions or the CLI's restricted namespace syntax.
      Native-size counters use the 64-bit host limit; a 32-bit host also applies its usize limit.
    </xs:documentation>
  </xs:annotation>

  <xs:simpleType name="nonEmpty">
    <xs:restriction base="xs:string">
      <xs:minLength value="1"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="identifier">
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Za-z0-9_-]+"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="pluginId">
    <xs:annotation><xs:documentation>All identifiers except the reserved provider core.</xs:documentation></xs:annotation>
    <xs:restriction base="p:identifier">
      <xs:pattern value=".{1,3}|.{5,}|[^c]...|c[^o]..|co[^r].|cor[^e]"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="operation">
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="endpoint">
    <xs:restriction base="xs:string">
      <xs:pattern value="wss?://[\s\S]*"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="mode">
    <xs:restriction base="xs:string">
      <xs:enumeration value="stress"/>
      <xs:enumeration value="smoke"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="versionOne">
    <xs:restriction base="p:positiveU32">
      <xs:enumeration value="1"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="positiveU32">
    <xs:restriction base="xs:integer">
      <xs:minInclusive value="1"/>
      <xs:maxInclusive value="4294967295"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="nonnegativeU32">
    <xs:annotation><xs:documentation>Explicit bounds accept Rust's leading plus (including +0) across xmllint versions; the pattern rejects -0 as Rust's unsigned parser does.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:integer">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="4294967295"/>
      <xs:pattern value="\+?[0-9]+"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="positiveU64">
    <xs:restriction base="xs:integer">
      <xs:minInclusive value="1"/>
      <xs:maxInclusive value="18446744073709551615"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="users">
    <xs:restriction base="p:positiveU32">
      <xs:minInclusive value="1"/>
      <xs:maxInclusive value="100000"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="concurrency">
    <xs:restriction base="p:positiveU32">
      <xs:minInclusive value="1"/>
      <xs:maxInclusive value="1000"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="connections">
    <xs:restriction base="p:positiveU64">
      <xs:minInclusive value="1"/>
      <xs:maxInclusive value="64"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="baselineProbes">
    <xs:restriction base="p:positiveU64">
      <xs:minInclusive value="1"/>
      <xs:maxInclusive value="1000"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="recoverySeconds">
    <xs:restriction base="p:nonnegativeU32">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="86400"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="rampSteps">
    <xs:restriction base="p:positiveU32">
      <xs:minInclusive value="1"/>
      <xs:maxInclusive value="10000"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="finiteDouble">
    <xs:restriction base="xs:double">
      <xs:minInclusive value="-1.7976931348623157E308"/>
      <xs:maxInclusive value="1.7976931348623157E308"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="positiveDouble">
    <xs:restriction base="p:finiteDouble">
      <xs:minExclusive value="0"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="nonnegativeDouble">
    <xs:restriction base="p:finiteDouble">
      <xs:minInclusive value="0"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="blockInterval">
    <xs:restriction base="p:finiteDouble">
      <xs:minInclusive value="0.1"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="ratio">
    <xs:restriction base="p:positiveDouble">
      <xs:maxInclusive value="1"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:complexType name="input">
    <xs:annotation><xs:documentation>Exactly one of ref or value is required. XSD 1.0 cannot express exclusive attributes; the CLI checks this rule.</xs:documentation></xs:annotation>
    <xs:attribute name="name" type="xs:string" use="required"/>
    <xs:attribute name="ref" type="xs:string"/>
    <xs:attribute name="value" type="xs:string"/>
  </xs:complexType>
  <xs:complexType name="step">
    <xs:sequence>
      <xs:element name="input" type="p:input" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="id" type="p:identifier" use="required"/>
    <xs:attribute name="use" type="p:operation" use="required"/>
    <xs:attribute name="timeout-ms" type="p:positiveU64" default="60000"/>
  </xs:complexType>
  <xs:complexType name="steps">
    <xs:sequence>
      <xs:element name="step" type="p:step" minOccurs="0" maxOccurs="unbounded">
        <xs:unique name="inputNames"><xs:selector xpath="p:input"/><xs:field xpath="@name"/></xs:unique>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="plugin">
    <xs:attribute name="id" type="p:pluginId" use="required"/>
    <xs:attribute name="version" type="p:nonEmpty" use="required"/>
    <xs:attribute name="protocol" type="p:versionOne" use="required"/>
  </xs:complexType>
  <xs:complexType name="plugins">
    <xs:sequence>
      <xs:element name="plugin" type="p:plugin" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="target">
    <xs:attribute name="id" type="p:identifier" use="required"/>
    <xs:attribute name="endpoint" type="p:endpoint" use="required"/>
  </xs:complexType>
  <xs:complexType name="targets">
    <xs:sequence>
      <xs:element name="target" type="p:target" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="credential">
    <xs:attribute name="id" type="p:identifier" use="required"/>
    <xs:attribute name="profile" type="p:nonEmpty" use="required"/>
  </xs:complexType>
  <xs:complexType name="credentials">
    <xs:sequence>
      <xs:element name="credential" type="p:credential" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="workflow">
    <xs:sequence>
      <xs:element name="step" type="p:step" minOccurs="0" maxOccurs="unbounded">
        <xs:unique name="workflowInputNames"><xs:selector xpath="p:input"/><xs:field xpath="@name"/></xs:unique>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="id" type="p:identifier" use="required"/>
    <xs:attribute name="users" type="p:users" default="1"/>
    <xs:attribute name="iterations" type="p:positiveU32" default="1"/>
    <xs:attribute name="concurrency" type="p:concurrency" default="1"/>
  </xs:complexType>
  <xs:complexType name="rate">
    <xs:attribute name="tx-per-second" type="p:nonnegativeDouble" use="required"/>
    <xs:attribute name="seconds" type="p:positiveU32" use="required"/>
  </xs:complexType>
  <xs:complexType name="ramp">
    <xs:annotation><xs:documentation>Exactly one of step or growth is required. XSD 1.0 cannot express exclusive attributes (xs:choice applies to elements); the CLI checks this rule and checks every expanded rate for overflow and negative values.</xs:documentation></xs:annotation>
    <xs:attribute name="start" type="p:positiveDouble" use="required"/>
    <xs:attribute name="step" type="p:finiteDouble"/>
    <xs:attribute name="growth" type="p:positiveDouble"/>
    <xs:attribute name="steps" type="p:rampSteps" use="required"/>
    <xs:attribute name="seconds" type="p:positiveU32" use="required"/>
  </xs:complexType>
  <xs:complexType name="load">
    <xs:annotation><xs:documentation>state-check and state-ref must appear together. XSD 1.0 cannot express attribute pairing; the CLI checks it and validates the operation provider and scoped references.</xs:documentation></xs:annotation>
    <xs:choice>
      <xs:element name="rate" type="p:rate" minOccurs="1" maxOccurs="10000"/>
      <xs:element name="ramp" type="p:ramp" minOccurs="1" maxOccurs="1"/>
    </xs:choice>
    <xs:attribute name="target" type="p:identifier" use="required"/>
    <xs:attribute name="source-ref" type="xs:string" use="required"/>
    <xs:attribute name="probes-ref" type="xs:string" use="required"/>
    <xs:attribute name="state-check" type="p:operation"/>
    <xs:attribute name="state-ref" type="xs:string"/>
    <xs:attribute name="connections" type="p:connections" default="4"/>
    <xs:attribute name="baseline-probes" type="p:baselineProbes" default="5"/>
    <xs:attribute name="recovery-seconds" type="p:recoverySeconds" default="900"/>
    <xs:attribute name="block-interval-seconds" type="p:blockInterval" default="6.0"/>
  </xs:complexType>
  <xs:complexType name="metric">
    <xs:annotation><xs:documentation>Metric roles and names are checked at preflight, not by polkameter validate.</xs:documentation></xs:annotation>
    <xs:attribute name="role" type="xs:string" use="required"/>
    <xs:attribute name="name" type="xs:string" use="required"/>
  </xs:complexType>
  <xs:complexType name="monitors">
    <xs:annotation><xs:documentation>Requires a load; the CLI checks this dependency. The relay target key reference is checked below. ParaId is a u32, including zero (system range), not a positive-only integer.</xs:documentation></xs:annotation>
    <xs:sequence>
      <xs:element name="metric" type="p:metric" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="topology" type="xs:string" use="required"/>
    <xs:attribute name="relay-target" type="p:identifier" use="required"/>
    <xs:attribute name="para-id" type="p:nonnegativeU32" use="required"/>
  </xs:complexType>
  <xs:complexType name="thresholds">
    <xs:attribute name="stall-ms" type="p:positiveU64" default="30000"/>
    <xs:attribute name="finality-stall-ms" type="p:positiveU64" default="60000"/>
    <xs:attribute name="max-p95-latency-ms" type="p:positiveU64" default="10000"/>
    <xs:attribute name="max-submit-reply-ms" type="p:positiveU64" default="5000"/>
    <xs:attribute name="min-included-ratio" type="p:ratio" default="0.9"/>
    <xs:attribute name="max-refused-ratio" type="p:ratio" default="0.01"/>
    <xs:attribute name="pool-refuses-ratio" type="p:ratio" default="0.1"/>
    <xs:attribute name="min-send-ratio" type="p:ratio" default="0.95"/>
    <xs:attribute name="max-block-gap-factor" type="p:positiveDouble" default="2.0"/>
    <xs:attribute name="probes-in-a-row" type="p:positiveU64" default="3"/>
    <xs:attribute name="recovered-block-gap-factor" type="p:positiveDouble" default="1.5"/>
    <xs:attribute name="finality-wait-ms" type="p:positiveU64" default="180000"/>
  </xs:complexType>
  <xs:element name="polkameter-plan">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="plugins" type="p:plugins"/>
        <xs:element name="targets" type="p:targets"/>
        <xs:element name="credentials" type="p:credentials"/>
        <xs:element name="preflight" type="p:steps"/>
        <xs:element name="setup" type="p:steps"/>
        <xs:element name="workflow" type="p:workflow"/>
        <xs:element name="load" type="p:load"/>
        <xs:element name="monitors" type="p:monitors"/>
        <xs:element name="thresholds" type="p:thresholds"/>
        <xs:element name="evaluate" type="p:steps"/>
        <xs:element name="teardown" type="p:steps"/>
      </xs:choice>
      <xs:attribute name="name" type="p:nonEmpty" use="required"/>
      <xs:attribute name="version" type="p:versionOne" use="required"/>
      <xs:attribute name="mode" type="p:mode" default="stress"/>
      <xs:attribute name="timeout-ms" type="p:positiveU64" default="3600000"/>
    </xs:complexType>
    <xs:unique name="pluginIds"><xs:selector xpath="p:plugins/p:plugin"/><xs:field xpath="@id"/></xs:unique>
    <xs:unique name="targetIds"><xs:selector xpath="p:targets/p:target"/><xs:field xpath="@id"/></xs:unique>
    <xs:unique name="credentialIds"><xs:selector xpath="p:credentials/p:credential"/><xs:field xpath="@id"/></xs:unique>
    <xs:unique name="workflowIds"><xs:selector xpath="p:workflow"/><xs:field xpath="@id"/></xs:unique>
    <xs:unique name="stepIds"><xs:selector xpath="p:preflight/p:step | p:setup/p:step | p:workflow/p:step | p:evaluate/p:step | p:teardown/p:step"/><xs:field xpath="@id"/></xs:unique>
    <xs:keyref name="loadTarget" refer="p:targetIds"><xs:selector xpath="p:load"/><xs:field xpath="@target"/></xs:keyref>
    <xs:keyref name="relayTarget" refer="p:targetIds"><xs:selector xpath="p:monitors"/><xs:field xpath="@relay-target"/></xs:keyref>
  </xs:element>
</xs:schema>
